<% if(errorMessage){ %>

    <div class="bg-red-100 text-red-700 px-4 py-3 rounded-lg">
        <%= errorMessage %>
    </div>

<% } %>
<form 
    action="/signIn" 
    method="POST"
    class="bg-white shadow-lg rounded-2xl p-8 flex flex-col gap-6"
>

    <h2 class="text-3xl font-bold text-center text-gray-800">
        Login
    </h2>

    <!-- Email -->
    <div class="relative">

        <input
            type="email"
            id="email"
            name="email"
            placeholder=" "
            required
            class="peer w-full border border-gray-300 rounded-lg px-4 pt-6 pb-2 outline-none focus:border-emerald-500"
        >

        <label
            for="email"
            class="absolute left-4 top-2 text-sm text-gray-500 transition-all
                   peer-placeholder-shown:top-4
                   peer-placeholder-shown:text-base
                   peer-placeholder-shown:text-gray-400
                   peer-focus:top-2
                   peer-focus:text-sm
                   peer-focus:text-emerald-500"
        >
            Email
        </label>

    </div>

    <!-- Password -->
    <div class="relative">

        <input
            type="password"
            id="password"
            name="password"
            placeholder=" "
            required
            class="peer w-full border border-gray-300 rounded-lg px-4 pt-6 pb-2 outline-none focus:border-emerald-500"
        >

        <label
            for="password"
            class="absolute left-4 top-2 text-sm text-gray-500 transition-all
                   peer-placeholder-shown:top-4
                   peer-placeholder-shown:text-base
                   peer-placeholder-shown:text-gray-400
                   peer-focus:top-2
                   peer-focus:text-sm
                   peer-focus:text-emerald-500"
        >
            Password
        </label>

    </div>

    <!-- Submit -->
    <button
        type="submit"
        class="bg-emerald-500 hover:bg-emerald-600 text-white py-3 rounded-lg font-semibold transition"
    >
        Login
    </button>

</form>