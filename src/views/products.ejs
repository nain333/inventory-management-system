<table class="min-w-full table-auto border-collapse bg-black text-white">

  <!-- HEADER -->
  <thead>
    <tr class="bg-gray-800">
      <th class="border px-2 py-2 md:px-4 text-center">ID</th>
      <th class="border px-2 py-2 md:px-4 text-left">Name</th>
      <th class="border px-2 py-2 md:px-4 text-center">Price</th>

      <!-- Hide heavy columns on small screens -->
      <th class="border px-2 py-2 md:px-4 text-left hidden md:table-cell">
        Description
      </th>

      <th class="border px-2 py-2 md:px-4 text-center hidden sm:table-cell">
        Image
      </th>

      <!-- ACTION COLUMN -->
      <th class="border px-2 py-2 md:px-4 text-center">
        Actions
      </th>
    </tr>
  </thead>

  <!-- BODY -->
  <tbody>

    <% products.forEach(product => { %>

      <tr class="border-b hover:bg-gray-700">

        <!-- ID -->
        <td class="border px-2 py-2 md:px-4 text-center">
          <%= product.id %>
        </td>

        <!-- NAME -->
        <td class="border px-2 py-2 md:px-4 text-left">
          <%= product.name %>
        </td>

        <!-- PRICE -->
        <td class="border px-2 py-2 md:px-4 text-center">
          <%= product.price %>
        </td>

        <!-- DESCRIPTION -->
        <td class="border px-2 py-2 md:px-4 text-left hidden md:table-cell">
          <%= product.desc %>
        </td>

        <!-- IMAGE -->
        <td class="border px-2 py-2 md:px-4 text-center hidden sm:table-cell">
          <img 
            src="<%= product.imageUrl %>" 
            class="w-16 h-24 md:w-20 md:h-28 object-cover mx-auto rounded"
            alt="<%= product.name %>"
          />
        </td>

        <!-- ACTION BUTTONS -->
        <td class="border px-2 py-2 md:px-4">

          <div class="flex flex-col md:flex-row gap-2 justify-center items-center">

            <!-- UPDATE BUTTON -->
            <a 
              href="/update-product/<%= product.id %>"
              class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded text-sm transition"
            >
              Update
            </a>

            <!-- DELETE BUTTON -->
            <form 
              action="/delete-product/<%= product.id %>" 
              method="POST"
            >
              <button
                type="submit"
                class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-sm transition"
              >
                Delete
              </button>
            </form>

          </div>

        </td>

      </tr>

    <% }) %>

  </tbody>
</table>