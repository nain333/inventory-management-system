<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Tailwind Output -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="/main.js"></script>
    <title>Inventory</title>
</head>

<body class="bg-gray-100">

    <!-- Navbar -->
    <header>
        <nav class="w-full bg-gray-900 text-white px-6 py-4 flex justify-between items-center">

            <!-- Logo -->
            <div class="text-xl font-bold">
                Inventory
            </div>

            <!-- Links -->
            <div class="hidden md:flex gap-6">
                <% if(locals.userEmail){ %>
                
                <a href="/" class="hover:text-emerald-400 text-lg">Products</a>
                <a href="/new" class="hover:text-emerald-400 text-lg">Add Product</a>
                <a href="/signOut" class="hover:text-emerald-400 text-lg">Sign Out</a>
                <% }else{ %>

                <a href="/register">Register</a>
                <a href="/signIn">Sign In</a>
                <% } %>
            </div>

            <!-- Mobile button -->
            <button class="md:hidden bg-gray-700 px-3 py-1 rounded">
                <i class="fa-solid fa-bars text-white text-xl"></i>
            </button>

        </nav>
    </header>

    <!-- Main Content -->
    <main class="min-h-screen flex flex-col items-center">

        <!-- Centered Content Container -->
        <div class="w-full max-w-xl px-4 mt-8">

            <!-- Page Title -->
            <h1 class="text-4xl text-center mb-6">Products</h1>

            <!-- Dynamic View Content -->
            <%- body %>

        </div>

    </main>

</body>

</html>